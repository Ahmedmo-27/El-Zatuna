APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack

DEBUGBAR_ENABLED=false
DEBUGBAR_STORAGE_ENABLED=false
DEBUGBAR_OPTIONS_DB_BACKTRACE=false
DEBUGBAR_OPTIONS_MESSAGES_TRACE=false
DEBUGBAR_DEBUG_BACKTRACE_LIMIT=10
DEBUGBAR_COLLECTORS_VIEWS=false
DEBUGBAR_COLLECTORS_FILES=false
DEBUGBAR_COLLECTORS_MODELS=false

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_DOMAIN=null

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

JWT_SECRET=

# Geidea (see config/geidea.php)
GEIDEA_PUBLIC_KEY=
GEIDEA_REGION=EGY
GEIDEA_API_PASSWORD=
GEIDEA_CURRENCY=EGP
GEIDEA_LANGUAGE=en
GEIDEA_PAYMENT_OPERATION=Pay
GEIDEA_CARD_ON_FILE=false
GEIDEA_CALLBACK_URL=
GEIDEA_RETURN_URL=

FRONTEND_URL=http://localhost

# Cloudflare R2 (optional)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=
R2_REGION=auto
R2_SSL_VERIFY=true

STREAM_WORKER_BASE=
STREAM_TOKEN_TTL=120
STREAM_TOKEN_SECRET=

MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"
BREVO_API_KEY=
BREVO_SSL_VERIFY=true
